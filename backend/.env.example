APP_NAME=YPGym API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Local host connection strings. The Compose MongoDB container binds to
# localhost:27018 by default to avoid clashing with a local mongod on 27017.
# Use mongodb://mongodb:27017/ypgym and redis://redis:6379/0 inside Docker
# Compose backend containers.
MONGODB_URI=mongodb://localhost:27018/ypgym
MONGODB_DB=ypgym
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

EMAIL_FROM=no-reply@ypgym.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

AI_API_KEY=
AI_MODEL=

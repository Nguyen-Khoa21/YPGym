APP_NAME=YPGym API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5174
MOBILE_APP_URL=ypgym://
GYM_TIMEZONE=Asia/Ho_Chi_Minh
CORS_EXTRA_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:19006

# Local host connection strings. The Compose PostgreSQL container binds to
# localhost:5433 by default to avoid clashing with local PostgreSQL installs.
DATABASE_URL=postgresql+asyncpg://ypgym:ypgym_dev_password@localhost:5433/ypgym
REDIS_URL=redis://localhost:6380/0

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

EMAIL_DELIVERY_MODE=development
EMAIL_SENDER_NAME=YPGym Team
EMAIL_SENDER_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
EMAIL_MAX_DELIVERY_ATTEMPTS=5
EMAIL_RETRY_DELAY_SECONDS=300
EMAIL_DELIVERY_BATCH_SIZE=25

QR_TOKEN_TTL_SECONDS=60
ATTENDANCE_TIMEOUT_MINUTES=180
GYM_CAPACITY=150
IOT_DEVICE_API_KEY=local-iot-key
DEVELOPMENT_SEED_PASSWORD=YPGymDemo123!
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Local development mail outbox; contains private one-time links, never commit it.
DEVELOPMENT_MAIL_DIR=storage/mail
INVOICE_STORAGE_DIR=storage/invoices

APP_NAME=YPGym API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Local host connection strings. The Compose MongoDB container binds to
# localhost:27018 by default in this repo because this machine already has
# a local mongod on 27017.
MONGODB_URI=mongodb://localhost:27018/ypgym
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

AI_API_KEY=

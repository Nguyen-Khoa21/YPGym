        <mxCell id="note-1" value="&lt;b&gt;Request workflow&lt;/b&gt;&lt;br/&gt;&lt;font face='Consolas'&gt;pending → approved | rejected&lt;/font&gt;. Only an approved cancellation changes membership state; rejection preserves it." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=1.5;size=18;" vertex="1" parent="1">

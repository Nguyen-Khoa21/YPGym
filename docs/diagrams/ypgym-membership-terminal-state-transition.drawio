        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Authorization&lt;/b&gt;&lt;br/&gt;Manager/admin may decide requests. Membership revocation is admin-only and requires a reason." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">

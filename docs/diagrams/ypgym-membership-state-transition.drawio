        <mxCell id="note-1" value="&lt;b&gt;Unverified account&lt;/b&gt;&lt;br/&gt;Every dated non-terminal state can enter &lt;font face='Consolas'&gt;pending_verification&lt;/font&gt;. Access checks deny immediately; the scheduled sync commits the state." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#DFF4E8;strokeColor=#166534;fontColor=#123D2A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="790" width="520" height="125"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Verified account&lt;/b&gt;&lt;br/&gt;The target is selected in order: active freeze window, expired date, 0–7 days remaining, otherwise active." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="790" width="520" height="125"/>
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Terminal boundary&lt;/b&gt;&lt;br/&gt;&lt;font face='Consolas'&gt;cancelled&lt;/font&gt; and &lt;font face='Consolas'&gt;revoked&lt;/font&gt; are immutable and excluded from verification reconciliation." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEF1EE;strokeColor=#6B766F;fontColor=#26332C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1250" y="790" width="520" height="125"/>
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Notation&lt;/b&gt;  state boxes use exact stored values · arrow = event [guard] / action · dashed = rule/limitation&lt;br/&gt;&lt;b&gt;Controlling sources&lt;/b&gt;  derive_membership_status; MEMBERSHIP_TRANSITIONS; synchronize_membership_statuses; test_unverified_membership_is_reconciled_to_pending_verification" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#34443B;fillColor=#F2EFE4;strokeColor=#A7B1AA;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">

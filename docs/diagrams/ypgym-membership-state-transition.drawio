      <mxCell id="60" parent="1" value="Access rule&#10;Active and Expiring Soon may generate QR tokens and book classes. All other effective states block member access." vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontSize=13;fillColor=#FFF7ED;strokeColor=#64748B;fontColor=#334155;"><mxGeometry x="50" y="340" width="330" height="130" as="geometry" /></mxCell><mxCell id="61" parent="1" value="Cancellation-request rule&#10;A logical workflow, not a stored MembershipStatus. Pending/rejected requests preserve the effective status; approval stores Cancelled and one financial outcome." vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontSize=13;fillColor=#FAF5FF;strokeColor=#64748B;fontColor=#334155;"><mxGeometry x="1250" y="510" width="610" height="170" as="geometry" /></mxCell><mxCell id="62" parent="1" value="Terminal rule&#10;Cancelled/Revoked records are never reactivated by the worker. Self-service purchase is denied when the latest membership is Revoked. Pending Verification is an effective account/access state." vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontSize=13;fillColor=#FFF7ED;strokeColor=#64748B;fontColor=#334155;"><mxGeometry x="50" y="630" width="460" height="130" as="geometry" /></mxCell></root>

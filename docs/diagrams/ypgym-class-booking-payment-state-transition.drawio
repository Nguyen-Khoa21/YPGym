        <mxCell id="note-1" value="&lt;b&gt;Capacity + locking&lt;/b&gt;&lt;br/&gt;Checkout locks class and booking rows. Occupancy counts &lt;font face='Consolas'&gt;confirmed&lt;/font&gt; plus unexpired &lt;font face='Consolas'&gt;pending_payment&lt;/font&gt; holds." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="820" width="520" height="110"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Queue fairness&lt;/b&gt;&lt;br/&gt;Failure, cancellation, expiry, cleanup and late-review release promote the earliest eligible waiting member in the same class-locked transaction." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#DFF4E8;strokeColor=#166534;fontColor=#123D2A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="820" width="500" height="110"/>
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Refund meaning&lt;/b&gt;&lt;br/&gt;&lt;font face='Consolas'&gt;refunded&lt;/font&gt; means an admin recorded internal resolution; provider reversal is not confirmed." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="820" width="560" height="110"/>
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Notation&lt;/b&gt;  state boxes use exact stored values · arrow = event [guard] / action · dashed = rule/limitation&lt;br/&gt;&lt;b&gt;Controlling sources&lt;/b&gt;  VNPayPaymentService create/process/finalize/expire; BookingService.cancel; WaitlistPromotionService.promote; BOOKING_TRANSITIONS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#34443B;fillColor=#F2EFE4;strokeColor=#A7B1AA;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">

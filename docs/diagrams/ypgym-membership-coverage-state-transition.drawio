        <mxCell id="note-1" value="&lt;b&gt;Derivation precedence&lt;/b&gt;&lt;br/&gt;For verified accounts: active freeze window → &lt;font face='Consolas'&gt;frozen&lt;/font&gt;; past expiry → &lt;font face='Consolas'&gt;expired&lt;/font&gt;; 0–7 days → &lt;font face='Consolas'&gt;expiring_soon&lt;/font&gt;; otherwise &lt;font face='Consolas'&gt;active&lt;/font&gt;." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="790" width="650" height="125"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Renewal boundary&lt;/b&gt;&lt;br/&gt;Expired self-service purchase creates a new &lt;font face='Consolas'&gt;active&lt;/font&gt; row. The declared &lt;font face='Consolas'&gt;expired → active&lt;/font&gt; edge has no runtime writer for that old row." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#FFF1C7;strokeColor=#B7791F;fontColor=#6B420A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="790" width="650" height="125"/>
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Notation&lt;/b&gt;  state boxes use exact stored values · arrow = event [guard] / action · dashed = rule/limitation&lt;br/&gt;&lt;b&gt;Controlling sources&lt;/b&gt;  derive_membership_status; decide_freeze_request; synchronize_membership_statuses; MembershipService.purchase/finalize_vnpay_payment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=11;fontColor=#34443B;fillColor=#F2EFE4;strokeColor=#A7B1AA;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">

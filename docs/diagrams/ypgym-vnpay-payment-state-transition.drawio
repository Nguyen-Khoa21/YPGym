        <mxCell id="note-1" value="&lt;b&gt;No state change&lt;/b&gt;&lt;br/&gt;Invalid signature/merchant → RspCode 97&lt;br/&gt;Amount mismatch → RspCode 04&lt;br/&gt;Duplicate terminal callback → RspCode 02" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#FFF1C7;strokeColor=#B7791F;fontColor=#6B420A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="130" width="590" height="100"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Legacy compatibility&lt;/b&gt;&lt;br/&gt;&lt;font face='Consolas'&gt;succeeded&lt;/font&gt; is created by mock/staff purchase and remains terminal. Current VNPay success uses &lt;font face='Consolas'&gt;paid&lt;/font&gt;." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEF1EE;strokeColor=#6B766F;fontColor=#26332C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="780" width="480" height="120"/>
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Manual resolution boundary&lt;/b&gt;&lt;br/&gt;&lt;font face='Consolas'&gt;paid_review&lt;/font&gt; records a class-payment exception. Admin resolution updates booking/refund state only; no VNPay query, reconciliation, or reversal API is called." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="640" width="590" height="170"/>
        </mxCell>
        <mxCell id="note-4" value="&lt;b&gt;Membership late-success gap&lt;/b&gt;&lt;br/&gt;Only late class success can enter review. A late successful membership callback stays terminal and returns RspCode 02." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#FFF1C7;strokeColor=#B7791F;fontColor=#6B420A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="830" width="590" height="100"/>
        </mxCell>

          <mxGeometry as="geometry" x="780" y="390" width="250" height="74"/>
        </mxCell>
        <mxCell id="manual_closed" value="manual_closed" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="590" width="250" height="74"/>
        </mxCell>
        <mxCell id="initial" value="" style="ellipse;html=1;aspect=fixed;fillColor=#123D2A;strokeColor=#123D2A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="419" width="28" height="28"/>
        </mxCell>
        <mxCell id="edge-700" value="scanner check-in [all guards pass]&lt;br/&gt;&lt;font color='#526159'&gt;/ create session + check_in event&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="initial" target="active">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="edge-1" value="scanner checkout [valid device + current QR]&lt;br/&gt;&lt;font color='#526159'&gt;/ close + event&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="active" target="checked_out">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="650" y="300"/>
              <mxPoint x="905" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="Celery every 5m [checked_in_at &lt;= cutoff]&lt;br/&gt;&lt;font color='#526159'&gt;/ close + event&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="active" target="timed_out">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="edge-3" value="staff close [active + reason]&lt;br/&gt;&lt;font color='#526159'&gt;/ actor + audit + event&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="active" target="manual_closed">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="650" y="590"/>
              <mxPoint x="905" y="590"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;Check-in guards&lt;/b&gt;&lt;br/&gt;Authenticated and rate-limited device · current QR · eligible membership · duplicate key accepted · no active session." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="650" width="540" height="145"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Concurrency&lt;/b&gt;&lt;br/&gt;Row locks protect close operations. A PostgreSQL partial unique index enforces at most one &lt;font face='Consolas'&gt;active&lt;/font&gt; session per user." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#DFF4E8;strokeColor=#166534;fontColor=#123D2A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="760" width="540" height="120"/>
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Idempotency&lt;/b&gt;&lt;br/&gt;Repeated timeout skips non-active rows. Repeated manual close returns the existing terminal session without another event or audit record." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEF1EE;strokeColor=#6B766F;fontColor=#26332C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="650" width="560" height="145"/>
        </mxCell>

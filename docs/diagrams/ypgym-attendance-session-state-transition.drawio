        <mxCell id="title" value="YPGym · Attendance session lifecycle" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=28;fontStyle=1;fontColor=#123D2A;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="35" width="1300" height="42"/>
        </mxCell>
        <mxCell id="subtitle" value="PostgreSQL is authoritative; every terminal transition writes an immutable event and then reconciles occupancy." style="text;html=1;align=left;verticalAlign=top;fontFamily=Inter;fontSize=13;fontColor=#526159;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="82" width="1600" height="48"/>
        </mxCell>

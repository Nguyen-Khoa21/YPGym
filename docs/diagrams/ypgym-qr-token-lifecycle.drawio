        <mxCell id="title" value="YPGym · QR token lifecycle" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=28;fontStyle=1;fontColor=#123D2A;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="35" width="1300" height="42"/>
        </mxCell>
        <mxCell id="subtitle" value="Temporary JWT + Redis state. Outcomes are validation results, not persisted PostgreSQL token states." style="text;html=1;align=left;verticalAlign=top;fontFamily=Inter;fontSize=13;fontColor=#526159;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="82" width="1600" height="48"/>
        </mxCell>
        <mxCell id="badge" value="CODE-VERIFIED · 4B75236" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;align=center;fontFamily=Inter;fontSize=12;fontStyle=1;fillColor=#123D2A;strokeColor=#123D2A;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1605" y="42" width="245" height="36"/>
        </mxCell>
        <mxCell id="current" value="issued + current" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#DFF4E8;strokeColor=#166534;fontColor=#123D2A;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="270" y="330" width="250" height="74"/>
        </mxCell>
        <mxCell id="valid_use" value="valid use" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="170" width="220" height="74"/>
        </mxCell>
        <mxCell id="duplicate_scan" value="duplicate_scan" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#FFF1C7;strokeColor=#B7791F;fontColor=#6B420A;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="490" width="250" height="74"/>
        </mxCell>
        <mxCell id="superseded" value="superseded" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="130" width="220" height="74"/>
        </mxCell>
        <mxCell id="expired" value="expired" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#FBE1DE;strokeColor=#C2413A;fontColor=#7A201B;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="360" width="220" height="74"/>
        </mxCell>
        <mxCell id="inactive" value="inactive / invalid" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#FBE1DE;strokeColor=#C2413A;fontColor=#7A201B;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="540" width="250" height="74"/>
        </mxCell>
        <mxCell id="unavailable" value="state unavailable" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Consolas;fontSize=16;fontStyle=1;fillColor=#EEF1EE;strokeColor=#6B766F;fontColor=#26332C;strokeWidth=2;shadow=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="660" width="250" height="74"/>
        </mxCell>
        <mxCell id="initial" value="" style="ellipse;html=1;aspect=fixed;fillColor=#123D2A;strokeColor=#123D2A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="351" width="28" height="28"/>
        </mxCell>
        <mxCell id="edge-700" value="generate [eligible membership + Redis]&lt;br/&gt;&lt;font color='#526159'&gt;/ sign JWT + track JTI&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="initial" target="current">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="edge-1" value="validate [current JWT + Redis mappings]&lt;br/&gt;&lt;font color='#526159'&gt;/ allow; successful scan stays reusable&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;startArrow=block;startFill=1;startSize=8;" edge="1" parent="1" source="current" target="valid_use">
          <mxGeometry as="geometry" relative="1" y="-28">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="600" y="290"/>
              <mxPoint x="870" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="repeat scan [same JTI inside window]&lt;br/&gt;&lt;font color='#526159'&gt;/ reject 409; window expiry permits validation&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;startArrow=block;startFill=1;startSize=8;" edge="1" parent="1" source="current" target="duplicate_scan">
          <mxGeometry as="geometry" relative="1" y="24">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="600" y="450"/>
              <mxPoint x="700" y="450"/>
              <mxPoint x="700" y="527"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-3" value="issue newer token [same user]&lt;br/&gt;&lt;font color='#526159'&gt;/ delete old JTI + replace pointer&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="current" target="superseded">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="580" y="130"/>
              <mxPoint x="1370" y="130"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" value="TTL/JWT expiry [time elapsed]&lt;br/&gt;&lt;font color='#526159'&gt;/ reject&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="current" target="expired">
          <mxGeometry as="geometry" relative="1" y="-32">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-5" value="missing/malformed/mismatched state [validation fails]&lt;br/&gt;&lt;font color='#526159'&gt;/ reject&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="current" target="inactive">
          <mxGeometry as="geometry" relative="1" y="22">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="620" y="620"/>
              <mxPoint x="1180" y="620"/>
              <mxPoint x="1180" y="577"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-6" value="Redis read failure [cannot verify state]&lt;br/&gt;&lt;font color='#526159'&gt;/ fail closed 503&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#3F5147;strokeWidth=1.5;fontFamily=Inter;fontSize=12;fontColor=#26332C;labelBackgroundColor=#FFFDF7;spacing=4;" edge="1" parent="1" source="current" target="unavailable">
          <mxGeometry as="geometry" relative="1" y="22">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="600" y="700"/>
              <mxPoint x="885" y="700"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;Replay scope&lt;/b&gt;&lt;br/&gt;Check-in uses a short Redis &lt;font face='Consolas'&gt;SET NX&lt;/font&gt; key. Check-out validates the current token but does not use that replay key." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#FFF1C7;strokeColor=#B7791F;fontColor=#6B420A;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="730" width="540" height="135"/>
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;Not single-use&lt;/b&gt;&lt;br/&gt;A successful scan does not consume the JTI. After the duplicate window, active-session rules—not token consumption—block another check-in." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#E4EFFA;strokeColor=#2563A6;fontColor=#17395C;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="800" width="540" height="125"/>
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;Revocation boundary&lt;/b&gt;&lt;br/&gt;Superseding issuance is the only revoke-like operation. There is no explicit revoke endpoint or durable token table." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSize=12;fillColor=#EEE6F8;strokeColor=#7C3FA0;fontColor=#4E2468;strokeWidth=1.5;size=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="730" width="560" height="135"/>
        </mxCell>

  <diagram id="ypgym-qr-token-lifecycle.drawio" name="YPGym · QR token lifecycle">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFDF7">
      <root>
        <mxCell id="0"/>

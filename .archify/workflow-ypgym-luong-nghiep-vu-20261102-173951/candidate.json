  "cards": [
    {
      "dot": "emerald",
      "title": "Cách đọc nhanh",
      "items": [
        "Hàng đầu là hành trình lý tưởng của hội viên, đọc từ trái sang phải.",
        "Các hàng giữa mở chi tiết thanh toán, QR, lớp học và tác vụ vận hành.",
        "Hàng đỏ cuối là các nhánh bị từ chối, chờ xử lý hoặc cần nhân sự can thiệp."
      ]
    },
    {
      "dot": "cyan",
      "title": "Vì sao dùng TypeScript",
      "items": [
        "Một ngôn ngữ cho React web, Expo member app và Expo scanner giúp đội ngũ ít đổi ngữ cảnh.",
        "Kiểu tĩnh giúp phát hiện sớm sai contract API, trạng thái payment, booking và membership trước khi chạy.",
        "React/TanStack Query phù hợp UI nhiều trạng thái tải, lỗi, cache và cập nhật lại dữ liệu."
      ]
    },
    {
      "dot": "violet",
      "title": "Vì sao dùng Python",
      "items": [
        "FastAPI + Pydantic tạo API async, validation rõ và tài liệu OpenAPI tự động.",
        "SQLAlchemy async giữ luồng endpoint → service → repository nhất quán cho nghiệp vụ nhiều giao dịch.",
        "Celery dùng lại cùng code Python để chạy reminder, expiry, timeout và class completion ngoài request web."
      ]
    },
    {
      "dot": "amber",
      "title": "Vì sao PostgreSQL và Redis đi cùng nhau",
      "items": [
        "PostgreSQL là nguồn sự thật cho account, membership, payment, invoice, attendance, booking và audit; giao dịch và row lock chống ghi đè/overbooking.",
        "Redis chỉ giữ dữ liệu ngắn hạn hoặc dựng lại được: QR JTI, duplicate guard, cache occupancy, rate limit, Pub/Sub và Celery broker.",
        "Nếu Redis lỗi, dữ liệu bền vững trong PostgreSQL không bị biến thành nguồn phụ thuộc vào cache."
      ]
    },
    {
      "dot": "rose",
      "title": "Các quyết định nghiệp vụ quan trọng",
      "items": [
        "VNPay IPN hợp lệ mới hoàn tất giao dịch; trang return chỉ điều hướng và client chỉ polling trạng thái.",
        "Lớp học là sản phẩm trả phí độc lập với membership; lớp đầy chuyển sang waitlist theo thứ tự.",
        "Workout YPTrain chỉ cho ghi khi có check-in hợp lệ trong ngày và membership còn đủ điều kiện.",
        "Freeze/cancel/revoke/manual close/config/export đều có phân quyền và audit; không chỉ ẩn nút ở frontend."
      ]
    }
  ]
}

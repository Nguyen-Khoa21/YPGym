  "cards": [
    {
      "dot": "emerald",
      "title": "Cách đọc nhanh",
      "items": [
        "Hàng đầu là hành trình lý tưởng của hội viên, đọc từ trái sang phải.",
        "Các hàng giữa mở chi tiết thanh toán, QR, lớp học và tác vụ vận hành.",
        "Các ô đỏ là nhánh bị chặn, hết hạn, trùng lặp hoặc cần nhân sự can thiệp.",
        "Các link Source được ghim vào commit e5fe895; bấm một bước để mở đúng file và dòng code trên GitHub."
      ]
    },
    {
      "dot": "cyan",
      "title": "Những phần code đã được đối chiếu",
      "items": [
        "Thanh toán: payment_service.py, payos_service.py, payments.py, billing model/repository và migration 20261103_0019.",
        "Cloudflare/local: docker-compose.yml và docs/api/payos-payments.md mô tả biến webhook HTTPS và đường chuyển tiếp vào backend.",
        "Nghiệp vụ khác: auth, membership lifecycle, attendance/QR/realtime, class/waitlist, YPTrain, admin/RBAC và Celery.",
        "Domain ypgym.com.co và khóa payOS nằm trong cấu hình môi trường ngoài Git; sơ đồ chỉ link tới contract và điểm đọc cấu hình đã commit."
      ]
    },
    {
      "dot": "cyan",
      "title": "TypeScript + React + Expo — vì sao hợp YPGym",
      "items": [
        "Một ngôn ngữ cho web, app hội viên và scanner giúp tái dùng tư duy kiểu dữ liệu, API contract và cách xử lý lỗi.",
        "TypeScript bắt sớm sai tên trường hoặc trạng thái payment/booking/membership; JavaScript thuần chỉ lộ nhiều lỗi khi chạy.",
        "React + TanStack Query hợp với dữ liệu server thay đổi liên tục: loading, retry, polling payOS, cache và refetch sau sự kiện.",
        "Expo/React Native tránh duy trì hai codebase Swift và Kotlin khi YPGym chưa cần tính năng native đặc thù sâu."
      ]
    },
    {
      "dot": "violet",
      "title": "Python + FastAPI — vì sao không thêm Node/Java",
      "items": [
        "FastAPI + Pydantic tạo API async, validation rõ và tài liệu OpenAPI tự động.",
        "SQLAlchemy async giữ luồng endpoint → service → repository → model thống nhất cho payment, attendance và booking.",
        "Python đã bao phủ PDF invoice, payOS SDK, Celery và kiểm thử; thêm Node hoặc Java ở backend sẽ tăng runtime, deployment và contract phải bảo trì mà chưa tạo lợi ích tương xứng.",
        "FastAPI phù hợp workload I/O nhiều hơn CPU: gọi payOS, PostgreSQL, Redis, SMTP và phục vụ nhiều client."
      ]
    },
    {
      "dot": "amber",
      "title": "PostgreSQL — nguồn sự thật bắt buộc",
      "items": [
        "Quan hệ account → membership → payment → invoice → booking cần foreign key, unique/check constraint và transaction nguyên tử.",
        "Row lock và partial unique index ngăn bán quá ghế, dùng lại orderCode, tạo hai invoice hoặc dùng quyền lợi giảm giá hai lần.",
        "MongoDB linh hoạt schema nhưng không có lợi thế cho miền dữ liệu quan hệ dày đặc này; SQLite không phù hợp nhiều tiến trình API/worker và ghi đồng thời.",
        "MySQL vẫn có thể làm được, nhưng PostgreSQL đang được dùng xuyên suốt với asyncpg, Alembic, partial index và SQL đã kiểm chứng—đổi DB chỉ thêm rủi ro."
      ]
    },
    {
      "dot": "orange",
      "title": "Redis — nhanh, ngắn hạn, có thể dựng lại",
      "items": [
        "Redis giữ QR JTI có TTL, chống quét trùng, rate limit, cache occupancy/configuration, Pub/Sub và broker Celery.",
        "Dùng PostgreSQL cho mọi lần đếm/TTL sẽ tạo hot rows và I/O không cần thiết; dùng memory trong một FastAPI process lại không chia sẻ được với worker hoặc nhiều instance.",
        "Redis không thay PostgreSQL: attendance và payment đã commit trong SQL trước; cache/PubSub lỗi không được làm mất giao dịch bền vững.",
        "Vì dữ liệu Redis có thể tái tạo, vận hành dễ phục hồi hơn so với lưu quyền lợi tài chính hoặc lịch sử duy nhất trong cache."
      ]
    },
    {
      "dot": "slate",
      "title": "Celery Worker + Beat — tại sao không chạy trong request",
      "items": [
        "Beat lập lịch; worker xử lý hết hạn payOS, timeout attendance, membership lifecycle, reminder, email và hoàn tất lớp ngoài request HTTP.",
        "FastAPI BackgroundTasks gắn với vòng đời web process, không phù hợp lịch lặp lại hoặc công việc cần chạy dù không có người mở app.",
        "Cron đơn lẻ có thể gọi script, nhưng khó tái dùng service Python, retry/queue và tách tải; Celery dùng Redis broker đã có sẵn.",
        "Tách worker giúp webhook trả lời nhanh và tránh email/PDF/job định kỳ làm chậm API người dùng."
      ]
    },
    {
      "dot": "rose",
      "title": "payOS + Cloudflare — điểm tin cậy của thanh toán",
      "items": [
        "YPGym tạo orderCode và số tiền từ PostgreSQL; client không được gửi giá hay tự xác nhận đã trả.",
        "payOS cung cấp hosted VietQR/Napas 24/7; webhook đã ký mới được quyền chuyển pending → paid.",
        "Cloudflare Tunnel đưa HTTPS ypgym.com.co vào backend localhost mà không mở trực tiếp cổng router và có TLS/domain ổn định cho payOS.",
        "Trang return/cancel chỉ polling trạng thái local; sửa URL trình duyệt không thể kích hoạt membership hoặc ghế lớp.",
        "Hạn chế: backend vẫn nằm trên máy local, nên sleep/mất mạng/tắt cloudflared làm webhook gián đoạn; production nên dùng host luôn bật và giám sát delivery."
      ]
    },
    {
      "dot": "emerald",
      "title": "Docker Compose + Alembic — vận hành nhất quán",
      "items": [
        "API, PostgreSQL, Redis, worker, beat và frontend tách container để lỗi/tải của một tiến trình không trộn lẫn toàn bộ hệ thống.",
        "Health check và service dependency giảm lỗi khởi động sai thứ tự; volume giữ dữ liệu local.",
        "Alembic biến thay đổi schema thành lịch sử nâng/hạ có thể kiểm tra; sửa bảng thủ công sẽ khiến môi trường lệch nhau.",
        "Server cục bộ vẫn thuận tiện demo, còn Cloudflare chỉ là đường vào HTTPS—không thay thế backup, monitoring hay hạ tầng luôn sẵn sàng."
      ]
    },
    {
      "dot": "rose",
      "title": "Các quyết định nghiệp vụ quan trọng",
      "items": [
        "Webhook payOS hợp lệ mới hoàn tất giao dịch; duplicate delivery trả thành công nhưng không tạo quyền lợi/hóa đơn lần hai.",
        "Thanh toán tới muộn sau expire/cancel/fail chuyển paid_review; hệ thống không tự tạo lại quyền lợi đã mất hiệu lực.",
        "Lớp học là sản phẩm trả phí độc lập với membership; lớp đầy chuyển sang waitlist theo thứ tự.",
        "Ghế pending hết hạn được nhả và promote người đợi đầu tiên; refund payOS hiện được xử lý thủ công có audit.",
        "Workout YPTrain chỉ cho ghi khi có check-in hợp lệ trong ngày và membership còn đủ điều kiện.",
        "Freeze/cancel/revoke/manual close/config/export đều có phân quyền và audit; không chỉ ẩn nút ở frontend."
      ]
    }
  ]
}
